PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/uptime
JWT_SECRET=replace-with-a-long-random-string-at-least-16-chars
CLIENT_ORIGIN=http://localhost:5173
CRON_SECRET=replace-with-a-different-long-random-string
NODE_ENV=development

# For production (Render/Vercel): Trust X-Forwarded-For header from proxy
# This prevents rate-limit errors when deploying behind proxies
TRUST_PROXY=true
